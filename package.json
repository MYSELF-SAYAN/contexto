{
  "name": "contexto",
  "displayName": "Contexto — AI Context & Prompt Generator",
  "description": "Convert workspace files & codebase structure into clean, AI-ready prompts for Claude, ChatGPT, and local LLMs. 100% local, ultra-fast.",
  "version": "1.1.5",
  "publisher": "contexto",
  "icon": "media/icon.png",
  "license": "MIT",
  "homepage": "https://github.com/MYSELF-SAYAN/contexto#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MYSELF-SAYAN/contexto"
  },
  "bugs": {
    "url": "https://github.com/MYSELF-SAYAN/contexto/issues"
  },
  "galleryBanner": {
    "color": "#FBF7EE",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "context",
    "contexto",
    "ai",
    "claude",
    "llm",
    "prompt",
    "prompt-generator",
    "prompt-engineering",
    "gitingest",
    "repomix",
    "files2prompt",
    "token-counter",
    "codebase",
    "chatgpt",
    "deepseek",
    "cursor"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contexto",
          "title": "Contexto",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "contexto": [
        {
          "id": "contexto.contextView",
          "name": "Files"
        }
      ]
    },
    "commands": [
      {
        "command": "contexto.open",
        "title": "Open",
        "category": "Contexto"
      },
      {
        "command": "contexto.addFile",
        "title": "Add to Context",
        "category": "Contexto",
        "icon": "$(add)"
      },
      {
        "command": "contexto.addFolder",
        "title": "Add Folder to Context",
        "category": "Contexto",
        "icon": "$(file-directory-create)"
      },
      {
        "command": "contexto.addActiveFile",
        "title": "Add Active File",
        "category": "Contexto",
        "icon": "$(file-add)"
      },
      {
        "command": "contexto.addOpenEditors",
        "title": "Add Open Editors",
        "category": "Contexto"
      },
      {
        "command": "contexto.addWorkspace",
        "title": "Select All Files",
        "category": "Contexto",
        "icon": "$(check-all)"
      },
      {
        "command": "contexto.removeFile",
        "title": "Remove from Context",
        "category": "Contexto",
        "icon": "$(remove)"
      },
      {
        "command": "contexto.ignoreFile",
        "title": "Ignore in Context",
        "category": "Contexto",
        "icon": "$(eye)"
      },
      {
        "command": "contexto.ignoreFolder",
        "title": "Ignore Folder in Context",
        "category": "Contexto",
        "icon": "$(eye)"
      },
      {
        "command": "contexto.removeFromIgnore",
        "title": "Unignore in Context",
        "category": "Contexto",
        "icon": "$(eye-closed)"
      },
      {
        "command": "contexto.generatePrompt",
        "title": "Generate Prompt / Live Preview",
        "category": "Contexto",
        "icon": "$(play)"
      },
      {
        "command": "contexto.copyStructure",
        "title": "Copy Structure",
        "category": "Contexto",
        "icon": "$(list-tree)"
      },
      {
        "command": "contexto.copyFolderStructure",
        "title": "Copy Folder Structure",
        "category": "Contexto"
      },
      {
        "command": "contexto.copyWorkspaceStructure",
        "title": "Copy Workspace Structure",
        "category": "Contexto"
      },
      {
        "command": "contexto.copyPrompt",
        "title": "Copy Prompt",
        "category": "Contexto",
        "icon": "$(copy)"
      },
      {
        "command": "contexto.copyPromptAs",
        "title": "Copy Prompt As...",
        "category": "Contexto",
        "icon": "$(chevron-down)"
      },
      {
        "command": "contexto.copyPaths",
        "title": "Copy Paths",
        "category": "Contexto"
      },
      {
        "command": "contexto.copyFolderPaths",
        "title": "Copy Folder Paths",
        "category": "Contexto"
      },
      {
        "command": "contexto.copyContext",
        "title": "Copy Context",
        "category": "Contexto"
      },
      {
        "command": "contexto.copyFolderContext",
        "title": "Copy Folder Context",
        "category": "Contexto"
      },
      {
        "command": "contexto.exportContext",
        "title": "Export",
        "category": "Contexto",
        "icon": "$(save)"
      },
      {
        "command": "contexto.clearContext",
        "title": "Clear / Unselect All",
        "category": "Contexto",
        "icon": "$(clear-all)"
      },
      {
        "command": "contexto.refreshContext",
        "title": "Refresh",
        "category": "Contexto",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "contexto.addFile",
          "when": "!explorerResourceIsFolder",
          "group": "contexto@1"
        },
        {
          "command": "contexto.addFolder",
          "when": "explorerResourceIsFolder",
          "group": "contexto@1"
        },
        {
          "command": "contexto.copyContext",
          "when": "!explorerResourceIsFolder",
          "group": "contexto@2"
        },
        {
          "command": "contexto.copyFolderContext",
          "when": "explorerResourceIsFolder",
          "group": "contexto@2"
        },
        {
          "command": "contexto.copyFolderStructure",
          "when": "explorerResourceIsFolder",
          "group": "contexto@3"
        },
        {
          "command": "contexto.copyStructure",
          "when": "!explorerResourceIsFolder",
          "group": "contexto@3"
        },
        {
          "command": "contexto.copyPaths",
          "when": "!explorerResourceIsFolder",
          "group": "contexto@4"
        },
        {
          "command": "contexto.copyFolderPaths",
          "when": "explorerResourceIsFolder",
          "group": "contexto@4"
        },
        {
          "command": "contexto.ignoreFile",
          "when": "!explorerResourceIsFolder",
          "group": "contexto@5"
        },
        {
          "command": "contexto.ignoreFolder",
          "when": "explorerResourceIsFolder",
          "group": "contexto@5"
        },
        {
          "command": "contexto.removeFromIgnore",
          "group": "contexto@5"
        }
      ],
      "view/title": [
        {
          "command": "contexto.generatePrompt",
          "when": "view == contexto.contextView",
          "group": "navigation@1"
        },
        {
          "command": "contexto.copyPrompt",
          "when": "view == contexto.contextView",
          "group": "navigation@2"
        },
        {
          "command": "contexto.copyPromptAs",
          "when": "view == contexto.contextView",
          "group": "navigation@3"
        },
        {
          "command": "contexto.copyStructure",
          "when": "view == contexto.contextView",
          "group": "navigation@4"
        },
        {
          "command": "contexto.addWorkspace",
          "when": "view == contexto.contextView",
          "group": "navigation@5"
        },
        {
          "command": "contexto.clearContext",
          "when": "view == contexto.contextView",
          "group": "navigation@6"
        },
        {
          "command": "contexto.refreshContext",
          "when": "view == contexto.contextView",
          "group": "navigation@7"
        }
      ],
      "view/item/context": [
        {
          "command": "contexto.ignoreFile",
          "when": "view == contexto.contextView && viewItem == contextFile",
          "group": "inline"
        },
        {
          "command": "contexto.ignoreFolder",
          "when": "view == contexto.contextView && viewItem == contextFolder",
          "group": "inline"
        },
        {
          "command": "contexto.removeFromIgnore",
          "when": "view == contexto.contextView && (viewItem == contextIgnoredFile || viewItem == contextIgnoredFolder)",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Contexto",
      "properties": {
        "contexto.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Respect .gitignore patterns when scanning files."
        },
        "contexto.useContextignore": {
          "type": "boolean",
          "default": true,
          "description": "Respect .contextignore file for context-specific ignore patterns."
        },
        "contexto.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom glob patterns to ignore when building context."
        },
        "contexto.explicitIncludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Paths explicitly included — overrides all ignore rules (gitignore, contextignore, defaults, user patterns). Managed automatically via the Unignore command."
        },
        "contexto.defaultFormat": {
          "type": "string",
          "enum": [
            "xml",
            "markdown",
            "plaintext"
          ],
          "default": "xml",
          "description": "Default output format for generated context."
        },
        "contexto.maxFileSize": {
          "type": "number",
          "default": 1048576,
          "description": "Maximum file size in bytes to include in context (default: 1 MB)."
        },
        "contexto.includeTree": {
          "type": "boolean",
          "default": true,
          "description": "Include directory tree in generated context."
        },
        "contexto.includeFileContents": {
          "type": "boolean",
          "default": true,
          "description": "Include file contents in generated context."
        },
        "contexto.includeEmptyLines": {
          "type": "boolean",
          "default": true,
          "description": "Preserve empty lines in file contents."
        },
        "contexto.treeDepth": {
          "type": "number",
          "default": 0,
          "description": "Maximum depth for tree structure (0 = unlimited)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "test": "node ./dist/test/runTest.js",
    "package": "vsce package",
    "pretest": "npm run compile"
  },
  "dependencies": {
    "ignore": "^7.0.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.19.11",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3"
  }
}
